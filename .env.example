# PLACEHOLDERS ONLY. Copy to .env (git-ignored) and fill in locally.
# Never commit real values. Variables will be split per app (backend/frontend)
# when those apps are created; names here are provisional (see docs/ARCHITECTURE.md).

# --- Backend (Phase 3) ---
APP_ENV=development
DATABASE_URL=postgresql://DB_USER:DB_PASSWORD@localhost:5432/DB_NAME
SECRET_KEY=REPLACE_WITH_LONG_RANDOM_VALUE
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Frontend (Phase 1; only VITE_-prefixed values are exposed to the browser) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
